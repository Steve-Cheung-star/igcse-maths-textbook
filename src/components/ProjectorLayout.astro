---
// src/components/ProjectorLayout.astro
import ProjectorToolbar from "./ProjectorToolbar.astro";
---

<style is:global>
  @media (max-width: 768px) {
    #wb-enter-projector {
      display: none !important;
    }
  }

  /* =========================================
     1. UI HIDING & CLEANUP
     ========================================= */
  html[data-mode="bento"] {
    scroll-padding-top: 0 !important;
  }

  /* =========================================
     2. PRESENTATION SLIDE SNAPPING
     ========================================= */
  html[data-mode="bento"] .lesson-chunk {
    min-height: 100vh !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    padding: 2rem 2rem 4rem 2rem !important;
    box-sizing: border-box !important;
    position: relative !important;
  }

  .lesson-chunk {
    margin-bottom: 2rem;
  }

  /* =========================================
     3. OPTIMAL TYPOGRAPHY (Wide & Left-Aligned)
     ========================================= */
  html[data-mode="bento"] .sl-markdown-content p,
  html[data-mode="bento"] .sl-markdown-content ul,
  html[data-mode="bento"] .sl-markdown-content ol {
    max-width: none !important;
    text-align: left !important;
    margin-left: 0 !important;
  }

  html[data-mode="bento"] .sl-markdown-content aside,
  html[data-mode="bento"] .sl-markdown-content .starlight-aside {
    float: none !important;
    clear: both !important;
    position: relative !important;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin-top: 2.5rem !important;
    margin-bottom: 2.5rem !important;
    margin-left: 0 !important;
    text-align: left !important;
  }

  /* =========================================
     4. NATIVE HARDWARE-ACCELERATED CURSORS
     ========================================= */
  html[data-mode="bento"][data-tool="laser"],
  html[data-mode="bento"][data-tool="laser"] body,
  html[data-mode="bento"][data-tool="laser"] * {
    cursor: url('data:image/svg+xml;utf8,<svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="7" fill="%23ff0000" stroke="white" stroke-width="2.5" box-shadow="0 0 10px red"/></svg>') 12 12, auto !important;
  }
  html[data-mode="bento"][data-tool="pen"] body {
    cursor: crosshair !important;
  }
  html[data-mode="bento"][data-tool="eraser"] body {
    cursor: cell !important;
  }

  /* =========================================
     5. SHRINK SVGS
     ========================================= */
  html[data-mode="bento"] .sl-markdown-content svg {
    max-width: 80%;
    height: auto;
  }

  html[data-mode="bento"] .sl-markdown-content aside svg,
  html[data-mode="bento"] .sl-markdown-content .starlight-aside svg {
    max-width: none;
  }

  html[data-mode="bento"] .sl-markdown-content .katex svg,
  html[data-mode="bento"] .sl-markdown-content .katex-display svg {
    max-width: none !important;
    width: 100%;
    height: inherit;
  }

  /* =========================================
     6. BOTTOM DETAILS & PROGRESSIVE REVEAL
     ========================================= */
  
  html[data-mode="bento"] .lesson-chunk:has(details) {
    max-height: 100vh !important;
    background-color: #eef7ff !important; /* Pale pastel blue applied to the whole card */
    border-radius: 0.75rem !important;
  }

  html[data-mode="bento"] .lesson-chunk details {
    position: relative !important;
    width: 100% !important;
    margin-top: 2rem !important;
    flex: 1 1 0 !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: auto !important;
    overflow-wrap: break-word !important;
    
    /* Removed padding so the text aligns cleanly with the question above */
    padding: 0 !important; 
    box-sizing: border-box !important;
    
    /* Transparent background lets the blue shine through uniformly */
    background: transparent !important; 
    border: none !important;
    box-shadow: none !important;
  }

  /* Force all text elements inside the solution box to be red */
  html[data-mode="bento"] .lesson-chunk details,
  html[data-mode="bento"] .lesson-chunk details * {
    color: #e60000 !important; 
  }

  html[data-mode="bento"] .lesson-chunk details summary {
    display: none !important;
  }

  html[data-mode="bento"] .lesson-chunk details > p,
  html[data-mode="bento"] .lesson-chunk details > pre,
  html[data-mode="bento"] .lesson-chunk details > blockquote,
  html[data-mode="bento"] .lesson-chunk details > div,
  html[data-mode="bento"] .lesson-chunk details > h2,
  html[data-mode="bento"] .lesson-chunk details > h3,
  html[data-mode="bento"] .lesson-chunk details > h4,
  html[data-mode="bento"] .lesson-chunk details > ul > li,
  html[data-mode="bento"] .lesson-chunk details > ol > li {
    display: none;
    margin-bottom: 1rem;
  }
  
  html[data-mode="bento"] .lesson-chunk details > p.revealed,
  html[data-mode="bento"] .lesson-chunk details > pre.revealed,
  html[data-mode="bento"] .lesson-chunk details > blockquote.revealed,
  html[data-mode="bento"] .lesson-chunk details > div.revealed,
  html[data-mode="bento"] .lesson-chunk details > h2.revealed,
  html[data-mode="bento"] .lesson-chunk details > h3.revealed,
  html[data-mode="bento"] .lesson-chunk details > h4.revealed {
    display: block;
    animation: slideIn 0.15s ease-out forwards;
  }

  html[data-mode="bento"] .lesson-chunk details > ul > li.revealed,
  html[data-mode="bento"] .lesson-chunk details > ol > li.revealed {
    display: list-item;
    animation: slideIn 0.15s ease-out forwards;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  html[data-mode="bento"] .lesson-chunk details::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  html[data-mode="bento"] .lesson-chunk details::-webkit-scrollbar-thumb {
    background: #e60000; 
    border-radius: 3px;
  }
</style>

<ProjectorToolbar />

<script>
  import { projectorStore } from "../store/projectorStore.js";

  function initLayout() {
    if (document.documentElement.dataset.layoutInit) return;
    document.documentElement.dataset.layoutInit = "true";

    let previousBentoState = false;

    const enterBtn = document.getElementById("wb-enter-projector");
    if (enterBtn) {
      enterBtn.addEventListener("click", () => {
        if (window.innerWidth < 768) return;
        projectorStore.setKey("isBento", true);
      });
    }

    projectorStore.subscribe((state: any) => {
      if (state.isBento !== previousBentoState) {
        if (state.isBento) {
          document.documentElement.setAttribute("data-mode", "bento");
          document.documentElement.setAttribute("data-tool", state.tool);
          
          setTimeout(() => {
            const chunkElements = document.querySelectorAll(".lesson-chunk");
            const viewportCenter = window.innerHeight / 2;
            let targetChunk = null;
            
            for (let i = 0; i < chunkElements.length; i++) {
              const rect = chunkElements[i].getBoundingClientRect();
              if (rect.top <= viewportCenter && rect.bottom >= viewportCenter) {
                targetChunk = chunkElements[i];
                break;
              }
            }
            if (targetChunk) targetChunk.scrollIntoView({ behavior: "instant", block: "start" });
          }, 30);
        } else {
          document.documentElement.removeAttribute("data-mode");
          document.documentElement.removeAttribute("data-tool");
        }
        previousBentoState = state.isBento;
      } else if (state.isBento) {
        document.documentElement.setAttribute("data-tool", state.tool);
      }
    });

    window.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (window.innerWidth < 768) return;

        if ((e.ctrlKey || e.metaKey) && e.altKey && (e.key?.toLowerCase() === "p" || e.code === "KeyP")) {
          e.preventDefault();
          projectorStore.setKey("isBento", !projectorStore.get().isBento);
          return;
        }

        if (projectorStore.get().isBento) {
          const isNext = e.key === "ArrowRight" || e.key === "PageDown" || e.key === " ";
          const isPrev = e.key === "ArrowLeft" || e.key === "PageUp";

          if (isNext || isPrev) {
            e.preventDefault(); 
            e.stopPropagation(); 

            const chunkElements = document.querySelectorAll(".lesson-chunk");
            if (chunkElements.length === 0) return;

            const viewportHeight = window.innerHeight;
            
            let currentChunk = chunkElements[0];
            let currentIndex = 0;
            let maxVisibleHeight = 0;

            for (let i = 0; i < chunkElements.length; i++) {
              const chunk = chunkElements[i];
              const rect = chunk.getBoundingClientRect();
              const visibleTop = Math.max(0, rect.top);
              const visibleBottom = Math.min(viewportHeight, rect.bottom);
              const visibleHeight = visibleBottom - visibleTop;

              if (visibleHeight > maxVisibleHeight) {
                maxVisibleHeight = visibleHeight;
                currentChunk = chunk;
                currentIndex = i;
              }
            }

            const details = currentChunk.querySelector("details");
            const rect = currentChunk.getBoundingClientRect();

            if (isNext) {
              if (details) {
                const stepsNodes = details.querySelectorAll(":scope > p, :scope > pre, :scope > blockquote, :scope > div, :scope > h2, :scope > h3, :scope > h4, :scope > ul > li, :scope > ol > li");
                const steps = Array.from(stepsNodes);

                if (!details.hasAttribute("open")) {
                  currentChunk.scrollIntoView({ behavior: "instant", block: "start" });
                  details.setAttribute("open", "true");
                  if (steps.length > 0) steps[0].classList.add("revealed");
                  return;
                }

                const nextStep = steps.find(step => !step.classList.contains("revealed"));
                if (nextStep) {
                  currentChunk.scrollIntoView({ behavior: "instant", block: "start" });
                  nextStep.classList.add("revealed");
                  nextStep.scrollIntoView({ behavior: "instant", block: "nearest" });
                  return;
                }
              }

              if (rect.bottom > viewportHeight + 10) {
                const distanceToBottom = rect.bottom - viewportHeight;
                const scrollAmount = Math.min(viewportHeight, distanceToBottom);
                window.scrollBy({ top: scrollAmount, left: 0, behavior: "instant" });
              } 
              else if (currentIndex < chunkElements.length - 1) {
                chunkElements[currentIndex + 1].scrollIntoView({ behavior: "instant", block: "start" });
              }
            }

            if (isPrev) {
              if (details && details.hasAttribute("open")) {
                currentChunk.scrollIntoView({ behavior: "instant", block: "start" });
                details.removeAttribute("open");
                
                const revealedSteps = details.querySelectorAll(".revealed");
                for (let i = 0; i < revealedSteps.length; i++) {
                  revealedSteps[i].classList.remove("revealed");
                }
                return;
              }

              if (rect.top < -10) {
                const distanceToTop = Math.abs(rect.top);
                const scrollAmount = Math.min(viewportHeight, distanceToTop);
                window.scrollBy({ top: -scrollAmount, left: 0, behavior: "instant" });
              } 
              else if (currentIndex > 0) {
                chunkElements[currentIndex - 1].scrollIntoView({ behavior: "instant", block: "start" });
              }
            }
          }
        }
      },
      true 
    );
  }

  initLayout();
  document.addEventListener("astro:page-load", initLayout);
</script>