---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import FormulaBox from './FormulaBox.astro';

const { entry } = Astro.locals.starlightRoute;

// Tell TypeScript to expect that our custom 'formula' string might exist
const customData = entry?.data as { formula?: string };
const formula = customData?.formula;
---

{/* 1. Render the normal Starlight Title first */}
<Default><slot /></Default>

{/* 2. The Graceful Utility Bar */}
<div class="print-utility-bar no-print">
  <button onclick="window.print()" class="print-meta-btn">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 6 2 18 2 18 9"></polyline>
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
      <rect x="6" y="14" width="12" height="8"></rect>
    </svg>
    <span>Print Page</span>
  </button>
</div>

{/* 3. Your existing Formula Box logic */}
{formula && (
  <div class="header-formula">
    <FormulaBox title="Key Formula">
      {formula}
    </FormulaBox>
  </div>
)}

<style>
  /* Your utility bar styles */
  .print-utility-bar {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .print-meta-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    transition: color 0.2s ease;
  }

  .print-meta-btn:hover {
    color: var(--sl-color-text-accent);
  }

  /* Your existing formula styles */
  .header-formula {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  /* =========================================
     PRINT OVERRIDES
     ========================================= */
  @media print {
    /* Hide the print button itself */
    .no-print {
      display: none !important;
    }

    /* Force the summary to show, overriding projector mode's "display: none" */
    details summary {
      display: list-item !important;
      font-weight: bold !important;
      margin-bottom: 0.5rem !important;
    }

    /* Force all hidden steps/elements inside details to be visible */
    details > * {
      display: block !important;
      opacity: 1 !important;
      animation: none !important;
    }

    /* Specifically ensure list items revert to bullet points instead of block */
    details li {
      display: list-item !important;
      margin-bottom: 0.5rem !important;
    }
  }
</style>

<script>
  // We use the DOM dataset to track state, which avoids all TypeScript custom property errors!
  if (document.documentElement.dataset.printHandlersSetup !== 'true') {
    document.documentElement.dataset.printHandlersSetup = 'true';

    // Fires instantly when Print Dialog is summoned
    window.addEventListener('beforeprint', () => {
      document.querySelectorAll('details').forEach(detail => {
        // Tag it with its current state so we know whether to close it later
        detail.dataset.wasOpen = detail.open ? 'true' : 'false';
        
        // Force expand
        detail.open = true;
      });
    });

    // Fires instantly when Print Dialog is closed/cancelled
    window.addEventListener('afterprint', () => {
      document.querySelectorAll('details').forEach(detail => {
        // If it was closed before the user clicked print, close it again
        if (detail.dataset.wasOpen === 'false') {
          detail.open = false;
        }
        
        // Clean up our temporary data attribute
        delete detail.dataset.wasOpen;
      });
    });
  }
</script>